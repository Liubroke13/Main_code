\contentsline {figure}{\numberline {2.21}{\ignorespaces Based on Eq.~(\ref {eq:transverse_exact_component}), polarization and instantaneous polarization distributions of $\text {Re} \bigl [\tilde {\bm {\mathcal {A}}}_{1,-1,-1,\ell '}^{\|}(\bm {q}_\parallel ,t;\alpha ,\beta =\pi /2) \bigr ]$ at $\omega t=0$ for various $\alpha $. Animation accessible via Figure~\ref {fig:transverse_real_alphachange_QR}}}{25}{figure.caption.38}%
