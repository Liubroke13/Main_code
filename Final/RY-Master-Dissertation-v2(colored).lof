\addvspace {10\p@ }
\contentsline {figure}{\numberline {1.1}{\ignorespaces (a) Calculated band structures of MoS$_2$ with different layers, reproduced from Ref.~\blx@tocontentsinit {0}\cite {splendiani2010emerging}. (b) Side view and (c) top view of transition-metal dichalcogenide (TMD) monolayer with the unit cell framed by the dashed line, reproduced from Ref.~\blx@tocontentsinit {0}\cite {krasnok2018valley}. (d) The first Brillouin zone of TMD monolayer in the recipical space and the selected high symetry points}}{1}{figure.caption.6}%
\contentsline {figure}{\numberline {1.2}{\ignorespaces (a) Illustration of a photon carrying momentum $\bm {Q}_c$ exciting (leaving) an electron (hole) with crystal momentum $\bm {k}+\bm {Q}$ ($-\bm {k}$), forming an exciton with center-of-mass (COM) momentum $\bm {Q}$. (b) Schematic of ideal of light cone and relation between COM momentum $\bm {Q}$ and $\bm {Q}_c$}}{2}{figure.caption.7}%
\contentsline {figure}{\numberline {1.3}{\ignorespaces (a) Calculated band structure of WSe$_2$, showing spin-up (red) and spin-down (blue) states, together with a schematic illustration of valley-selective optical transitions at the $K$ and $K'$ valleys, which couple to right- and left-circularly polarized light, respectively, reproduced from Ref.~\blx@tocontentsinit {0}\cite {peng2019distinctive}. (b) Schematic configurations of excitonic states, including spin-allowed bright excitons (BXs), momentum-forbidden dark excitons (DXs), and spin-forbidden DXs.}}{2}{figure.caption.8}%
\contentsline {figure}{\numberline {1.4}{\ignorespaces The lowest valley-degenerate (left) and valley-split (right) exciton bands in MoS$_2$ along the $Q_x$ direction, reproduced from Ref.~\blx@tocontentsinit {0}\cite {peng2022tailoring}.}}{3}{figure.caption.9}%
\contentsline {figure}{\numberline {1.5}{\ignorespaces Illustration of the radiation patterns of BXs, DXs, and GXs in neutral WSe$_2$, along with the corresponding optical excitation indicated by arrows (reproduced from Ref.~\blx@tocontentsinit {0}\cite {schneider2020direct}).}}{3}{figure.caption.9}%
\contentsline {figure}{\numberline {1.6}{\ignorespaces (a) Illustration of the conversion between right-handed and left-handed circularly polarized light generating a torque on a suspended birefringent half-wave plate. (b) Illustration of transforming a Laguerre–Gaussian (LG) mode carrying OAM $\ell \hslash $ per photon into a mode with $-\ell \hslash $ per photon, which produces a mechanical torque on suspended cylindrical lenses. (c) Demonstration of generating an LG beam with nonzero $\ell $ (left side of bottom row) by introducing a phase shift when converting Hermite–Gaussian modes with zero $\ell $ (left side of top row). All reproduced from Ref.~\blx@tocontentsinit {0}\cite {allen1992oam}.}}{4}{figure.caption.10}%
\contentsline {figure}{\numberline {1.7}{\ignorespaces Illustration of twisted light with a helical wavefront, where each photon carries $\ell \hslash $ of orbital angular momentum. The intensified charge-coupled device camera images show the characteristic doughnut-shaped intensity profile. Reproduced from Ref.~\blx@tocontentsinit {0}\cite {erhard2018twisted}.}}{4}{figure.caption.11}%
\contentsline {figure}{\numberline {1.8}{\ignorespaces Illustration of a beam focused by a lens, showing the variation of SAM before and after the lens along the propagation direction. Reproduced from Ref.~\blx@tocontentsinit {0}\cite {nieminen2008angular}.}}{5}{figure.caption.12}%
\contentsline {figure}{\numberline {1.9}{\ignorespaces (a) Transition-rate distribution for gray excitons in momentum space, reproduced from Ref.~\blx@tocontentsinit {0}\cite {sanchez2024enhanced}. (b) Distribution of the incident light and the excited BX wave-packet states, reproduced from Ref.~\blx@tocontentsinit {0}\cite {peng2022tailoring}.}}{5}{figure.caption.12}%
\addvspace {10\p@ }
\contentsline {figure}{\numberline {2.1}{\ignorespaces Illustration of a dominant component of wavevector $\bm {q}_0$ lies along $\hat {\bm {z}}$}}{8}{figure.caption.13}%
\contentsline {figure}{\numberline {2.2}{\ignorespaces Illustration of the evolution of the beam radius $W(z)$ during propagation. The minimum beam radius $W_0$ occurs at the beam waist, and the Rayleigh range $z_R$ is defined as the distance from the waist at which $W(z_R)=\sqrt {2}W_0$.}}{10}{figure.caption.14}%
\contentsline {figure}{\numberline {2.3}{\ignorespaces Squared magnitude (intensity) and real part distribution of $A^{L}_{\ell , p}(\bm {r})$ at $z=0$. The green dotted line denotes the beam waist $W_0$. The scale bar indicates the length of 1 $\mathrm {\mu m}$.}}{10}{figure.caption.15}%
\contentsline {figure}{\numberline {2.4}{\ignorespaces \color {red}Illustration of the beam-radius evolution and far-field divergence angle $\theta _{\mathrm {div}}$.}}{11}{figure.caption.16}%
\contentsline {figure}{\numberline {2.5}{\ignorespaces Squared magnitude (intensity) and real part distribution of $\mathcal {A}^L_{\ell , p=0}(\bm {q}_\parallel )$. The scale bar indicates the considered $0.1$ times light cone range for WSe$_2$-monolayers, $Q_c = 8.6~\mu \mathrm {m}^{-1}$.}}{13}{figure.caption.18}%
\contentsline {figure}{\numberline {2.6}{\ignorespaces Magnitude (absolute value) of $\bm {A}_{\sigma , \ell , p=0}(\bm {r})$ at $z=0$ for different components and spin. The $\sigma \ell $ term leads to asymmetry between cases with the same $\ell $ in the longitudinal component (a wavelength of $532~\mathrm {nm}$ is assumed).}}{14}{figure.caption.19}%
\contentsline {figure}{\numberline {2.7}{\ignorespaces Squared magnitude (intensity) and real part distribution of $\tilde {\mathcal {A}}^{\parallel }_{\ell }(\bm {q}_\parallel )$. The scale bar indicates $0.1$ times the light-cone radius for WSe$_2$ monolayers, $Q_c = 8.6~\mu \mathrm {m}^{-1}$.}}{15}{figure.caption.20}%
\contentsline {figure}{\numberline {2.8}{\ignorespaces Squared magnitude (intensity) and real part distribution of $\tilde {\mathcal {A}}^{z}_{\sigma , \ell }(\bm {q}_\parallel )$. The scale bar indicates $0.1$ times the light-cone radius for WSe$_2$ monolayers, $Q_c = 8.6~\mu \mathrm {m}^{-1}$.}}{16}{figure.caption.21}%
\contentsline {figure}{\numberline {2.11}{\ignorespaces Examples for mismatched amplitudes. The left(right) panel shows the case for real(complex) amplitude, where $-\frac {\alpha '}{\Delta k}=\pi $ for the complex amplitude case.}}{18}{figure.caption.22}%
