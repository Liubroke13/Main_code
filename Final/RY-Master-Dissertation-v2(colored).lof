\contentsline {figure}{\numberline {3.7}{\ignorespaces Based on Eq.~(\ref {eq:transverse_exact_component}) and Eq.~(\ref {eq:matrixelement_exact_upper_BX}), distribution of $\text {Re}\bigl [\tilde {\bm {\mathcal {A}}}_{1,\ell ,-1,\ell '}^z(\bm {q}_\parallel ,t;\alpha =0,\beta =\frac {\pi }{2})\bigr ]$ (left panel) and $\text {Re}\bigl [\tilde {M}_{1,\ell ,-1,\ell '}^{B+,\bm {Q}}(\bm {Q}, t; \alpha =0, \beta =\frac {\pi }{2})\bigr ]$ (right panel) at $\omega t = 0$. The transition dipole moment for upper band BX is plotted in the middle. Animation accessible via Figure~\ref {fig:upper_bright_QR}.}}{32}{figure.caption.48}%
\contentsline {figure}{\numberline {3.8}{\ignorespaces Based on Eq.~(\ref {eq:transverse_exact_component}) and Eq.~(\ref {eq:matrixelement_exact_lower_BX}), distribution of $\text {Re}\bigl [\tilde {\bm {\mathcal {A}}}_{1,\ell ,-1,\ell '}^z(\bm {q}_\parallel ,t;\alpha =0,\beta =\frac {\pi }{2})\bigr ]$ (left panel) and $\text {Re}\bigl [\tilde {M}_{1,\ell ,-1,\ell '}^{B-,\bm {Q}}(\bm {Q}, t; \alpha =0, \beta =\frac {\pi }{2})\bigr ]$ (right panel) at $\omega t = 0$. The transition dipole moment for lower band BX is plotted in the middle. Animation accessible via Figure~\ref {fig:lower_bright_QR}.}}{33}{figure.caption.49}%
