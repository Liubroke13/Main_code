\contentsline {figure}{\numberline {2.13}{\ignorespaces Based on Eq.~(\ref {longitudinal_exact}), distribution of $\text {Re}\bigl [\tilde {\bm {\mathcal {A}}}_{1,\ell ,-1,\ell '}^z(\bm {q}_\parallel ,t;\alpha =0,\beta =\frac {\pi }{2})\bigr ]$ at $\omega t = 0$, with $\bar {J}$ indicated at the bottom right. Animation accessible via Figure~\ref {fig:longitudinal_real_alpha_QR}.}}{20}{figure.caption.26}%
\contentsline {figure}{\numberline {2.14}{\ignorespaces Based on Eq.~(\ref {longitudinal_exact}), distribution of $\bigl |\tilde {\bm {\mathcal {A}}}_{1,\ell ,-1,\ell '}^z(\bm {q}_\parallel ;\alpha =0,\beta =\frac {\pi }{2})\bigr |^2$, with $\Delta J$ indicated at the bottom right.}}{20}{figure.caption.27}%
\contentsline {figure}{\numberline {2.15}{\ignorespaces Based on Eq.~(\ref {longitudinal_exact}), distribution of $\bigl |\tilde {\bm {\mathcal {A}}}_{1,\ell ,-1,\ell '}^z(\bm {q}_\parallel ;\alpha =0,\beta =\frac {\pi }{2})\bigr |^2$, with $\Delta J$ indicated at the bottom right.}}{21}{figure.caption.28}%
\contentsline {figure}{\numberline {2.16}{\ignorespaces \href {https://liubroke13.github.io/transverse_polarization_alpha/}{Link} to the time evolution animation for Figure~\ref {fig:transverse}.}}{23}{figure.caption.31}%
\contentsline {figure}{\numberline {2.17}{\ignorespaces Based on Eq.~(\ref {eq:transverse_exact_component}), polarization and instantaneous polarization distributions of $\text {Re} \bigl [\tilde {\bm {\mathcal {A}}}_{1,\ell ,-1,\ell '}^{\|}(\bm {q}_\parallel ,t;\alpha =0,\beta =\frac {\pi }{2}) \bigr ]$ at $\omega t=0$, with $\bar {\ell }$ indicated at the bottom right. Animation accessible via Figure~\ref {fig:transverse_real_alpha_QR}.}}{24}{figure.caption.32}%
\contentsline {figure}{\numberline {2.18}{\ignorespaces \href {https://liubroke13.github.io/transverse2_polarization_alpha/}{Link} to the time evolution animation for Figure~\ref {fig:transverse2}.}}{24}{figure.caption.34}%
