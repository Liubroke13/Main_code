doi = {10.1088/1464-4258/10/11/115005},
url = {https://doi.org/10.1088/1464-4258/10/11/115005},
year = {2008},
month = {sep},
publisher = {},
volume = {10},
number = {11},
pages = {115005},
author = {Nieminen, Timo A and Stilgoe, Alexander B and Heckenberg, Norman R and Rubinsztein-Dunlop, Halina},
title = {Angular momentum of a strongly focused Gaussian beam},
journal = {Journal of Optics A: Pure and Applied Optics},
abstract = {A circularly polarized paraxial Gaussian laser beam carries  angular momentum per photon as spin, with zero orbital angular momentum. Focusing the beam with a rotationally symmetric lens cannot change this angular momentum flux, yet the focused beam must have spin  per photon. The remainder of the original spin is converted to orbital angular momentum, manifesting itself as a longitudinal optical vortex at the focus. We investigate the nature of this orbital angular momentum.}
}

