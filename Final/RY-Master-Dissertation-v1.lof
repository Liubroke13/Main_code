\contentsline {figure}{\numberline {1.1}{\ignorespaces (a) Illustration of the silicon lattice structure and Brillouin zone reproduced from Ref.~\blx@tocontentsinit {0}\cite {roisin2024phonon}. (b) Calculated band structure under uniaxial tensile strain reproduced from Ref.~\blx@tocontentsinit {0}\cite {roisin2024phonon}. (c) Illustration of the graphene lattice structure and Brillouin zone. (d) Graphene band structure measured using angle-resolved photoemission spectroscopy, reproduced from Ref.~\blx@tocontentsinit {0}\cite {bostwick2007quasiparticle}.}}{2}{figure.caption.6}%
\contentsline {figure}{\numberline {1.2}{\ignorespaces Calculated band structures of MoS$_2$ with different layers, reproduced from Ref.~\blx@tocontentsinit {0}\cite {splendiani2010emerging}.}}{2}{figure.caption.7}%
\contentsline {figure}{\numberline {1.3}{\ignorespaces Calculated band structures of WSe$_2$ with spin-up (red) and spin-down (blue) states reproduced from Ref.~\blx@tocontentsinit {0}\cite {peng2019distinctive}.}}{3}{figure.caption.8}%
\contentsline {figure}{\numberline {1.4}{\ignorespaces Illustration of a photon carrying momentum $\bm {Q}_c$ exciting (leaving) an electron (hole) with momentum $\bm {k}+\bm {Q}$ ($-\bm {k}$), forming an exciton with center-of-mass momentum $\bm {Q}$. The configurations of spin-allowed bright excitons, momentum-forbidden dark excitons, and spin-forbidden dark excitons are also illustrated.}}{4}{figure.caption.9}%
\contentsline {figure}{\numberline {1.5}{\ignorespaces (a) Illustration of the conversion between right-handed and left-handed circularly polarized light generating a torque on a suspended birefringent half-wave plate. (b) Illustration of transforming a Laguerre–Gaussian (LG) mode carrying OAM $\ell \hslash $ per photon into a mode with $-\ell \hslash $ per photon, which produces a mechanical torque on suspended cylindrical lenses. (c) Demonstration of generating an LG beam with nonzero $\ell $ (left side of bottom row) by introducing a phase shift when converting Hermite–Gaussian modes with zero $\ell $ (left side of top row). All reproduced from Ref.~\blx@tocontentsinit {0}\cite {allen1992oam}}}{5}{figure.caption.10}%
\contentsline {figure}{\numberline {1.6}{\ignorespaces Illustration of twisted light with a helical wavefront, where each photon carries $\ell \hslash $ of orbital angular momentum. The intensified charge coupled device camera images show the characteristic donut-shaped intensity profile. Reproduced from Ref.~\blx@tocontentsinit {0}\cite {erhard2018twisted}}}{5}{figure.caption.11}%
\contentsline {figure}{\numberline {1.7}{\ignorespaces (a) Schematic of optical communication between two islands separated by 143 kilometers. (b) Photograph of the transmitter. (c) Long-exposure photograph showing the superposition of twisted light beams. All reproduced from Ref.~\blx@tocontentsinit {0}\cite {sit2017high}. (d) Illustration of quantum key distribution between two buildings in Ottawa reproduced from Ref.~\blx@tocontentsinit {0}\cite {sit2017high}}}{6}{figure.caption.12}%
\contentsline {figure}{\numberline {1.8}{\ignorespaces Images of two-dimensional rotation of optically trapped objects: (a) silica spheres, (b) glass rod, and (c) chromosome, reproduced from Ref.~\blx@tocontentsinit {0}\cite {paterson2001controlled}}}{7}{figure.caption.13}%
