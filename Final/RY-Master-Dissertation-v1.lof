\contentsline {figure}{\numberline {2.1}{\ignorespaces Squared magnitude (intensity) and phase distribution of $u_{\ell , p}(\bm {r}_\parallel )$. The green dotted line denotes the beam waist $W_0$. The scale bar indicates the length of 1 $\rm {um}$}}{10}{figure.caption.13}%
\contentsline {figure}{\numberline {2.2}{\ignorespaces Squared magnitude and phase distribution of $\mathcal {A}^L_{\ell , p=0}(\bm {q}_\parallel )$. The scale bar indicates the considered light-cone range for WSe$_2$-monolayers, $Q_c = 8.6~\mu \mathrm {m}^{-1}$ .}}{11}{figure.caption.14}%
\contentsline {figure}{\numberline {2.3}{\ignorespaces Radial dependence of $\bm {A}^{\hat {\bm {\varepsilon }}, \ell , p=0; C}_{\bm {q}_0}(\bm {r})$ for different components and helicities (absolute value). The $\sigma \ell $ term leads to asymmetry between cases with the same $\ell $ in the longitudinal component (a wavelength of $532~\mathrm {nm}$ is assumed).}}{12}{figure.caption.15}%
\contentsline {figure}{\numberline {2.4}{\ignorespaces Phase distribution of different components of $\bm {\mathcal {A}}^C_{\ell p}(\bm {q}_\parallel )$ for different helicities.}}{13}{figure.caption.16}%
