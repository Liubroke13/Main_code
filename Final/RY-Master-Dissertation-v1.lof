\contentsline {figure}{\numberline {4.1}{\ignorespaces Normalized coefficient $\Lambda _{S,\bm {0}}(vc\bm {k})$ along $\bm {k}$ (magenta), where the vertical dashed lines indecate the $0.1$ and $1$ times light cone range $\bm {Q}_c$ (blue and red). The light cone range $\bm {Q}_c=8.6 {\rm \mu m}^{-1}$ is considered for WSe$_2$. The maximun value is corresponding to $\sqrt {2\pi } a_{B}^{*}$}}{32}{figure.caption.28}%
\contentsline {figure}{\numberline {4.2}{\ignorespaces Normalized squared magnitude distribution of the transverse component of the LG beam ($\ell =0$). The scale bar indicates $0.1$ times the light cone range for WSe$_2$ monolayers, $\bm {Q}_c = 8.6~\mu \mathrm {m}^{-1}$.}}{34}{figure.caption.31}%
\contentsline {figure}{\numberline {4.3}{\ignorespaces Normalized squared magnitudes of the optical matrix element and the valley exciton wave packet excited by a LG beam ($\ell =0$) with different polarization unit vectors $\hat {\bm {\varepsilon }}$. The scale bar indicates $0.1\,\bm {Q}_c$, and the beam waist is $W_0 = 1.5\,\mu \mathrm {m}^{-1}$.}}{35}{figure.caption.32}%
\contentsline {figure}{\numberline {4.4}{\ignorespaces Normalized squared magnitude distribution of the transverse component of the LG beam ($\ell =1$). The scale bar indicates $0.1$ times the light cone range for WSe$_2$ monolayers, $\bm {Q}_c = 8.6~\mu \mathrm {m}^{-1}$.}}{35}{figure.caption.33}%
\contentsline {figure}{\numberline {4.5}{\ignorespaces Normalized squared magnitudes of the optical matrix element and the valley exciton wave packet excited by a LG beam ($\ell =1$) with different polarization unit vectors $\hat {\bm {\varepsilon }}$. The scale bar indicates $0.1\,\bm {Q}_c$, and the beam waist is $W_0 = 1.5\,\mu \mathrm {m}^{-1}$.}}{36}{figure.caption.34}%
\contentsline {figure}{\numberline {4.6}{\ignorespaces Normalized squared magnitude distributions of the transverse component of the LG beam ($\ell =0$), together with the normalized squared magnitudes of the optical matrix element and the resulting valley exciton wave packet for different polarization unit vectors $\hat {\bm {\varepsilon }}$. The scale bar indicates $0.1\,\bm {Q}_c$, and the beam waist is $W_0 = 1.5\,\mu \mathrm {m}^{-1}$.}}{37}{figure.caption.35}%
