\addvspace {10\p@ }
\contentsline {figure}{\numberline {1.1}{\ignorespaces (a) Calculated band structures of MoS$_2$ with different layers, reproduced from Ref.~\blx@tocontentsinit {0}\cite {splendiani2010emerging}. (b) Side view and (c) top view of transition-metal dichalcogenide (TMD) monolayer with the unit cell framed by the dashed line, reproduced from Ref.~\blx@tocontentsinit {0}\cite {krasnok2018valley}. (d) The first Brillouin zone of TMD monolayer in the recipical space and the selected high symetry points}}{1}{figure.caption.5}%
\contentsline {figure}{\numberline {1.2}{\ignorespaces (a) Illustration of a photon carrying momentum $\bm {Q}_c$ exciting (leaving) an electron (hole) with crystal momentum $\bm {k}+\bm {Q}$ ($-\bm {k}$), forming an exciton with center-of-mass (COM) momentum $\bm {Q}$. (b) Schematic of ideal of light cone and relation between COM momentum $\bm {Q}$ and $\bm {Q}_c$}}{2}{figure.caption.6}%
\contentsline {figure}{\numberline {1.3}{\ignorespaces (a) Calculated band structure of WSe$_2$, showing spin-up (red) and spin-down (blue) states, together with a schematic illustration of valley-selective optical transitions at the $K$ and $K'$ valleys, which couple to right- and left-circularly polarized light, respectively, reproduced from Ref.~\blx@tocontentsinit {0}\cite {peng2019distinctive}. (b) Schematic configurations of excitonic states, including spin-allowed bright excitons (BXs), momentum-forbidden dark excitons (DXs), and spin-forbidden DXs.}}{2}{figure.caption.7}%
\contentsline {figure}{\numberline {1.4}{\ignorespaces The lowest valley-degenerate (left) and valley-split (right) exciton bands in MoS$_2$ along the $Q_x$ direction, reproduced from Ref.~\blx@tocontentsinit {0}\cite {peng2022tailoring}.}}{3}{figure.caption.8}%
\contentsline {figure}{\numberline {1.5}{\ignorespaces Illustration of the radiation patterns of BXs, DXs, and GXs in neutral WSe$_2$, along with the corresponding optical excitation indicated by arrows (reproduced from Ref.~\blx@tocontentsinit {0}\cite {schneider2020direct}).}}{3}{figure.caption.8}%
\contentsline {figure}{\numberline {1.6}{\ignorespaces (a) Illustration of the conversion between right-handed and left-handed circularly polarized light generating a torque on a suspended birefringent half-wave plate. (b) Illustration of transforming a Laguerre–Gaussian (LG) mode carrying OAM $\ell \hslash $ per photon into a mode with $-\ell \hslash $ per photon, which produces a mechanical torque on suspended cylindrical lenses. (c) Demonstration of generating an LG beam with nonzero $\ell $ (left side of bottom row) by introducing a phase shift when converting Hermite–Gaussian modes with zero $\ell $ (left side of top row). All reproduced from Ref.~\blx@tocontentsinit {0}\cite {allen1992oam}.}}{4}{figure.caption.9}%
\contentsline {figure}{\numberline {1.7}{\ignorespaces Illustration of twisted light with a helical wavefront, where each photon carries $\ell \hslash $ of orbital angular momentum. The intensified charge-coupled device camera images show the characteristic doughnut-shaped intensity profile. Reproduced from Ref.~\blx@tocontentsinit {0}\cite {erhard2018twisted}.}}{4}{figure.caption.10}%
\contentsline {figure}{\numberline {1.8}{\ignorespaces Illustration of a beam focused by a lens, showing the variation of SAM before and after the lens along the propagation direction. Reproduced from Ref.~\blx@tocontentsinit {0}\cite {nieminen2008angular}.}}{5}{figure.caption.11}%
\contentsline {figure}{\numberline {1.9}{\ignorespaces (a) Transition-rate distribution for gray excitons in momentum space, reproduced from Ref.~\blx@tocontentsinit {0}\cite {sanchez2024enhanced}. (b) Distribution of the incident light and the excited BX wave-packet states, reproduced from Ref.~\blx@tocontentsinit {0}\cite {peng2022tailoring}.}}{5}{figure.caption.11}%
\addvspace {10\p@ }
\contentsline {figure}{\numberline {2.1}{\ignorespaces Squared magnitude (intensity) and phase distribution of $u_{\ell , p}(\bm {r}_\parallel )$ at $z=0$. The green dotted line denotes the beam waist $W_0$. The scale bar indicates the length of 1 $\rm {um}$.}}{10}{figure.caption.12}%
\contentsline {figure}{\numberline {2.2}{\ignorespaces Squared magnitude and phase distribution of $\mathcal {A}^L_{\ell , p=0}(\bm {q}_\parallel )$ at $z=0$. The scale bar indicates the considered $0.1$ times light cone range for WSe$_2$-monolayers, $Q_c = 8.6~\mu \mathrm {m}^{-1}$.}}{11}{figure.caption.13}%
\contentsline {figure}{\numberline {2.3}{\ignorespaces Magnitude (absolute value) of $\bm {A}^{\hat {\bm {\varepsilon }}, \ell , p=0; C}_{\bm {q}_0}(\bm {r})$ at $z=0$ for different components and helicities. The $\sigma \ell $ term leads to asymmetry between cases with the same $\ell $ in the longitudinal component (a wavelength of $532~\mathrm {nm}$ is assumed).}}{12}{figure.caption.14}%
\contentsline {figure}{\numberline {2.4}{\ignorespaces Phase distribution of different components of $\bm {\mathcal {A}}^C_{\ell , p}(\bm {q}_\parallel )$ for different helicities. The scale bar indicates the considered $0.1$ times light cone range for WSe$_2$-monolayers, $Q_c = 8.6~\mu \mathrm {m}^{-1}$}}{13}{figure.caption.15}%
\contentsline {figure}{\numberline {2.5}{\ignorespaces The VVB state represented on the Poincar\'e sphere, parameterized by the azimuthal angle $\alpha $ and polar angle $\beta $. Several representative combinations of $\alpha $ and $\beta $ are illustrated on the sphere surface as examples.}}{14}{figure.caption.16}%
\contentsline {figure}{\numberline {2.6}{\ignorespaces Distribution (squared magnitude) of different components of $\bm {\mathcal {A}}^{1,0,-1,0}_\parallel (\bm {q}_\parallel ;\alpha ,\beta )$ on the Poincar\'e sphere, together with the corresponding polarization states of the transverse components. The scale bar indicates the considered $0.1$ times light cone range, $Q_c = 8.6~\mu \mathrm {m}^{-1}$}}{16}{figure.caption.17}%
\contentsline {figure}{\numberline {2.7}{\ignorespaces Distribution (squared magnitude) of different components of $\bm {\mathcal {A}}^{1,-1,-1,-1}_\parallel (\bm {q}_\parallel ;\alpha ,\beta )$ on the Poincar\'e sphere, together with the corresponding polarization states of the transverse components. The scale bar indicates the considered $0.1$ times light cone range, $Q_c = 8.6~\mu \mathrm {m}^{-1}$}}{16}{figure.caption.18}%
\addvspace {10\p@ }
\contentsline {figure}{\numberline {3.1}{\ignorespaces Illustration of the transition dipole moments of valley-mixed BXs~\blx@tocontentsinit {0}\cite {peng2022tailoring}, and their matching with the transverse polarization of the VVB states $|1,-1,-1,1;\alpha =0,\beta =\pi /2\rangle $ and $|1,-1,-1,1;\alpha =\pi ,\beta =\pi /2\rangle $ in momentum space.}}{20}{figure.caption.20}%
\contentsline {figure}{\numberline {3.2}{\ignorespaces Normalized transition rate of valley-mixed BXs excited by the VVB state $|1,-1,-1,1;\alpha ,\beta \rangle $ in momentum space. The scale bar indicates the considered $0.1$ times light cone range for WSe$_2$-monolayers, $Q_c = 8.6~\mu \mathrm {m}^{-1}$}}{21}{figure.caption.21}%
\contentsline {figure}{\numberline {3.3}{\ignorespaces Normalized transition rate of total BXs excited by the VVB state $|1,-1,-1,1;\alpha ,\beta \rangle $ in momentum space.}}{21}{figure.caption.22}%
\contentsline {figure}{\numberline {3.4}{\ignorespaces Distribution of the transverse component for the VVB state $|1,1,1,1;\alpha ,\beta \rangle $ in momentum space.}}{22}{figure.caption.23}%
\contentsline {figure}{\numberline {3.5}{\ignorespaces Normalized transition rate of valley-mixed BXs excited by the VVB state $|1,1,1,1;\alpha ,\beta \rangle $ in momentum space.}}{22}{figure.caption.23}%
\contentsline {figure}{\numberline {3.6}{\ignorespaces Normalized transition rate of GXs excited by the VVB state $|1,-1,-1,1;\alpha ,\beta \rangle $ in momentum space.}}{23}{figure.caption.24}%
\contentsline {figure}{\numberline {3.7}{\ignorespaces Normalized transition rate of GXs excited by the VVB state $|1,-1,-1,2;\alpha ,\beta \rangle $ in momentum space at the north/south poles of the Poincar\'e sphere.}}{23}{figure.caption.25}%
\contentsline {figure}{\numberline {3.8}{\ignorespaces Normalized transition rate of GXs excited by the VVB state $|1,-1,-1,2;\alpha ,\beta \rangle $ in momentum space along the equator of the Poincar\'e sphere. The scale and color bars are the same as in Figure~\ref {fig:GXtransition(L+3)}.}}{23}{figure.caption.25}%
\contentsline {figure}{\numberline {3.9}{\ignorespaces Normalized total transition rates of BXs, total BXs, and GX excited by a VVB state $|1,\ell ,-1,-\ell ;\alpha ,\beta =\pi /2\rangle $, for $\ell \in \mathbb {Z}$ with $\ell \in [-5,5]$, and for azimuthal angles $\alpha = 0, \pi /2, \pi $.}}{25}{figure.caption.26}%
\contentsline {figure}{\numberline {3.10}{\ignorespaces Normalized total transition rates of BXs, total BXs, and GXs excited by a VVB state $|1,-1,-1,1;\alpha ,\beta =\pi /2\rangle $ for azimuthal angles $\alpha = 0$ to $2\pi $.}}{26}{figure.caption.27}%
